[Unit]
Description=Notegram ingestion and Telegram delivery
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=60

[Service]
Type=simple
User=root
WorkingDirectory=/root
ExecStart=/root/notegram/.venv/bin/python -m notegram server --config /root/notegram/notegram.toml
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
